# ---- Database (Supabase: Settings -> Database -> Connection string) ----
# DATABASE_URL = pooled connection (port 6543, pgbouncer): used at runtime
# DIRECT_URL   = direct connection (port 5432): used by `prisma migrate`
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---- Auth ----
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Optional: enables "Continue with Google" (Google Cloud -> APIs & Services -> Credentials)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ---- Email (optional; without a key, verification links are printed in the server console) ----
# RESEND_API_KEY=""
# EMAIL_FROM="Spent <noreply@your-domain>"
# EMAIL_FROM_NOREPLY=""
# EMAIL_FROM_WELCOME=""
# EMAIL_REPLY_TO=""

# ---- Android (optional) ----
# Where the in-app update prompt links the APK. Defaults to /downloads/spent.apk on this site.
# ANDROID_APK_URL=""

# Support the developer (Razorpay). The secret stays on the server; only the key id is public.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
