// Spent — data model
// Money is always stored as integer minor units (cents) to avoid floating-point
// drift in financial calculations. Never store amounts as Float.
//
// Several fields that would be native enums are modeled as String here because
// the SQLite connector does not support Prisma enums. Allowed values are
// enforced at the application boundary via Zod (see src/lib/validations).
// Moving to Postgres later only requires switching `provider` and promoting
// these Strings to real `enum` types — the shape of the data doesn't change.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String
  avatar               String    @default("avatar-1")
  currency             String    @default("USD")
  currencyChangeCount  Int       @default(0) // capped at 3 lifetime changes — see updateCurrencyAction
  locale               String    @default("en-US")
  themePreference      String    @default("system") // light | dark | system
  notifyBills          Boolean   @default(true) // in-app notification prefs — no email/push infra, computed live from existing data
  notifyBudgets        Boolean   @default(true)
  notifyGoals          Boolean   @default(true)
  notifySubscriptions  Boolean   @default(true) // a subscription's newest generated occurrence posting at a different amount than its previous one
  notifyHolidays       Boolean   @default(true) // major national holidays/festivals for the user's primary currency — see lib/holidays.ts
  notifyLoans          Boolean   @default(true) // a Loan's dueDate within 3 days (or overdue) — see lib/data/notifications.ts
  readNotificationIds  String[]  @default([]) // ids of live-computed notifications already seen; replaced wholesale by "Mark all read" so stale ids self-prune once their underlying condition clears
  emailVerified        DateTime? // null until the signup email link is clicked (or Google confirms it)
  pendingEmail         String? // set while a requested email change awaits verification at the new address
  lastBackupAt         DateTime? // set whenever a backup is downloaded — shown on Backup & restore, and gates the "no backup on file" warning before Clear all data
  lastBackupFilename   String?
  dateOfBirth          DateTime? @db.Date // asked at sign-up (Spent is 18+) and used for the birthday wish
  phone                String? // optional
  lastBirthdayWishYear Int? // the year a birthday email was last sent, so it goes out once
  dobChangeCount       Int       @default(0) // times the birthday was changed after first being set; only one change is allowed
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts                Account[]
  categories              Category[]
  transactions            Transaction[]
  budgets                 Budget[]
  goals                   Goal[]
  recurring               RecurringTransaction[]
  tags                    Tag[]
  loans                   Loan[]
  parties                 Party[]
  splitGroups             SplitGroup[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime // shorter-lived than email verification — 1h, see lib/password-reset.ts
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            String // BANK | CASH | CREDIT_CARD | WALLET | UPI | SAVINGS | INVESTMENT | OTHER
  bankSubtype     String? // BANK accounts only: SAVINGS | CURRENT. Null for every other type.
  currency        String
  startingBalance Int      @default(0) // minor units, signed
  creditLimit     Int? // CREDIT_CARD accounts only: total limit in minor units. Null means not set.
  allowExpense    Boolean  @default(true) // SAVINGS ("Emergency Fund") accounts only: whether it's offered as a source for EXPENSE transactions. Always true (and ignored) for every other type.
  isEmergencyFund Boolean  @default(false) // SAVINGS accounts only: marks THE account recurring's "Emergency Fund" category auto-targets. At most one true per user, enforced in actions/accounts.ts (not a DB constraint).
  icon            String   @default("wallet")
  color           String   @default("slate")
  isArchived      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]          @relation("AccountTransactions")
  transfersIn  Transaction[]          @relation("TransferToAccount")
  recurring    RecurringTransaction[]
  goals        Goal[]

  @@index([userId])
}

model Category {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String // INCOME | EXPENSE
  icon       String     @default("circle")
  color      String     @default("slate")
  isArchived Boolean    @default(false)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  // Two levels only (enforced in the action layer, not here): a category with
  // a parent may not itself have children. Purely additive — setting this on
  // an existing category never touches its id, so every Transaction/
  // BudgetCategory/RecurringTransaction row pointing at it keeps working.
  parentId   String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Category[] @relation("CategoryHierarchy")

  transactions     Transaction[]
  budgetCategories BudgetCategory[]
  recurring        RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@index([parentId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  color  String @default("slate")

  transactions TransactionTag[]

  @@unique([userId, name])
}

model Transaction {
  id                     String                @id @default(cuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId              String
  account                Account               @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferToAccountId    String?
  transferToAccount      Account?              @relation("TransferToAccount", fields: [transferToAccountId], references: [id])
  categoryId             String?
  category               Category?             @relation(fields: [categoryId], references: [id])
  type                   String // EXPENSE | INCOME | TRANSFER
  amount                 Int // minor units, always positive; direction derived from `type`. For TRANSFER this is the amount debited from `account` (source currency).
  transferToAmount       Int? // minor units credited to `transferToAccount`, in ITS currency — only set when the two accounts' currencies differ; null means same amount/currency as `amount`.
  currency               String
  title                  String
  note                   String?
  date                   DateTime
  status                 String                @default("COMPLETED") // COMPLETED | UPCOMING
  recurringTransactionId String?
  recurring              RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])
  goalId                 String?
  goal                   Goal?                 @relation(fields: [goalId], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tags         TransactionTag[]
  // This transaction IS a loan (the lending/borrowing origin) — see Loan.transaction.
  loan         Loan?            @relation("LoanOrigin")
  // This transaction instead REPAYS someone else's loan — mutually exclusive with
  // `loan` above (a transaction never both originates and repays one). See
  // Loan.repayments.
  repaysLoanId String?
  repaysLoan   Loan?            @relation("LoanRepayments", fields: [repaysLoanId], references: [id], onDelete: SetNull)
  // The loans this transaction pays back, with how much went to each (replaces repaysLoanId).
  loanPayments LoanPayment[]    @relation("TransactionLoanPayments")
  // Money this payment sent out of the account for other people in a shared expense. `amount` is only your own
  // share (so reports and budgets count what you spent); the account balance goes down by amount + extraOut.
  extraOut     Int              @default(0)
  splitExpense SplitExpense?

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([repaysLoanId])
  @@index([transferToAccountId])
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  amount     Int // minor units, total budget limit
  period     String // WEEKLY | MONTHLY | YEARLY | CUSTOM
  startDate  DateTime
  endDate    DateTime? // required when period == CUSTOM
  rollover   Boolean   @default(false)
  color      String    @default("slate")
  icon       String    @default("piggy-bank")
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())

  categories BudgetCategory[]

  @@index([userId])
}

model BudgetCategory {
  id         String   @id @default(cuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limit      Int? // optional per-category cap, minor units

  @@unique([budgetId, categoryId])
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Int // minor units
  currentAmount Int       @default(0) // minor units
  targetDate    DateTime?
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id])
  icon          String    @default("target")
  color         String    @default("indigo")
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdAt     DateTime  @default(now())

  contributions Transaction[]

  @@index([userId])
}

model RecurringTransaction {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  title            String
  amount           Int
  currency         String
  type             String // EXPENSE | INCOME | TRANSFER
  frequency        String // DAILY | WEEKLY | MONTHLY | YEARLY
  interval         Int       @default(1)
  startDate        DateTime
  endDate          DateTime?
  nextOccurrence   DateTime
  lastGeneratedAt  DateTime?
  isSubscription   Boolean   @default(false)
  isActive         Boolean   @default(true)
  // Which day of the month a MONTHLY rule lands on: the start date's day, the last day, or the last Monday-to-Friday (salary).
  dayRule          String    @default("DAY") // DAY | MONTH_END | LAST_WORKING_DAY
  // true: the amount changes each time, so each occurrence stays pending until the person confirms the real amount.
  amountVaries     Boolean   @default(false)
  // An extra amount added every N months (a quarterly bonus on top of a salary), counted from the start month.
  bonusAmount      Int?
  bonusEveryMonths Int?
  createdAt        DateTime  @default(now())

  transactions Transaction[]

  @@index([userId])
  @@index([nextOccurrence])
}

// Preferences for one person or shop in "People & shops" (the chat view). Created only when the owner
// changes something (merge, mute, pin, mark as person or shop); until then a party is just the transactions
// that share a name. `key` is the normalised name (see lib/party.ts), so "Ramesh", "ramesh " and "RAMESH"
// are one party. Merging points one key at another; no transaction is ever renamed.
model Party {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String
  kind          String? // PERSON | MERCHANT: overrides the guess
  mergedIntoKey String?
  muted         Boolean  @default(false) // no loan reminders for this party
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

// Informal lending attached to a transaction — a "transfer to others" EXPENSE
// marked as money lent out (direction LENT), or an INCOME transaction marked
// as money borrowed (direction BORROWED). Editing the origin transaction to
// uncheck the loan toggle deletes this row, and deleting it cascades this away.
//
// Outstanding balance is computed, not stored: `transaction.amount - sum(repayments
// amounts)`. A loan is settled once that reaches zero, at which point it drops out
// of the reminder in lib/data/notifications.ts. Each repayment is a normal, real
// Income (against a LENT loan) or Expense (against a BORROWED loan) transaction that
// merely links back here via `repaysLoanId` — see the "Loan Repayment Received" /
// "Loan Repayment" categories in lib/constants.ts.
model Loan {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The origin transaction (the money that actually moved). Null for a loan carried over from an
  // older one (a "rolled over" balance): that loan has no money movement of its own, so its
  // `principal` / `title` / `currency` / `startDate` below describe it instead.
  transactionId    String?       @unique
  transaction      Transaction?  @relation("LoanOrigin", fields: [transactionId], references: [id], onDelete: Cascade)
  direction        String // LENT | BORROWED
  counterpartyType String? // BORROWED only: FRIEND | FAMILY | LENDER | BANK (older loans may say OTHER)
  dueDate          DateTime? // "return by" (LENT) or "repay by" (BORROWED); empty when no date was given
  createdAt        DateTime      @default(now())
  // Legacy single-loan link (kept so older rows and deploys keep working); new repayments use `payments`.
  repayments       Transaction[] @relation("LoanRepayments")
  payments         LoanPayment[]

  // Interest (simple, on the unpaid principal, calculated day by day until paid / stopped / closed).
  interestRate      Float? // percent; null or 0 = interest-free
  interestPeriod    String? // MONTH | YEAR — what the rate is "per"
  interestStoppedAt DateTime? // interest stops growing from this date (still owed, no longer increasing)

  // Closing out what is left: WAIVED (written off) or ROLLED_OVER (moved into a new loan).
  closedKind   String? // WAIVED | ROLLED_OVER
  closedAt     DateTime?
  closedAmount Int? // what was still owed (principal + interest) when it was closed

  // Added by hand for a loan taken or given outside Spent (no transaction, no account balance change).
  standalone Boolean @default(false)

  // Only for a loan without an origin transaction (a rolled-over balance).
  principal        Int?
  title            String?
  currency         String?
  startDate        DateTime?
  rolledFromLoanId String?
  rolledFrom       Loan?     @relation("LoanRollover", fields: [rolledFromLoanId], references: [id], onDelete: SetNull)
  rolledInto       Loan[]    @relation("LoanRollover")

  @@index([userId])
  @@index([dueDate])
  @@index([rolledFromLoanId])
}

// One slice of a repayment transaction applied to one loan. A single payment can settle several
// loans at once (someone lent 10,000 twice and pays back 20,000 in one go), so a repayment
// transaction has one row per loan it pays.
model LoanPayment {
  id            String       @id @default(cuid())
  loanId        String
  loan          Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  // The repayment transaction. Null for a payment made outside Spent (cash, someone else paid): no account moves.
  transactionId String?
  transaction   Transaction? @relation("TransactionLoanPayments", fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Int // minor units, in the loan's currency
  // For a payment without a transaction: when it was paid, and an optional note.
  paidOn        DateTime?
  note          String?

  @@unique([loanId, transactionId])
  @@index([transactionId])
}

/// A counter per key (for example "login:someone@example.com") inside a time window, used to rate-limit sign-in and similar requests.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())
}

// ---- Shared expenses ("Split") ----

model SplitGroup {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  currency   String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  members     SplitMember[]
  expenses    SplitExpense[]
  settlements SplitSettlement[]

  @@index([userId])
}

model SplitMember {
  id        String     @id @default(cuid())
  groupId   String
  group     SplitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  isYou     Boolean    @default(false)
  removedAt DateTime?
  createdAt DateTime   @default(now())

  paid      SplitExpense[]    @relation("SplitPaidBy")
  shares    SplitShare[]
  sent      SplitSettlement[] @relation("SplitSettlementFrom")
  received  SplitSettlement[] @relation("SplitSettlementTo")

  @@index([groupId])
}

model SplitExpense {
  id            String       @id @default(cuid())
  groupId       String
  group         SplitGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime
  total         Int // minor units, in the group's currency
  splitType     String // EQUAL | EXACT | PERCENT | SHARES
  paidById      String
  paidBy        SplitMember  @relation("SplitPaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  note          String?
  // Your own payment of it, when it came out of one of your accounts.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())

  shares SplitShare[]

  @@index([groupId, date])
}

model SplitShare {
  id        String       @id @default(cuid())
  expenseId String
  expense   SplitExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  String
  member    SplitMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  owed      Int // minor units this member owes for the expense
  input     Float? // what was typed: a percent or a number of shares (null for equal and exact)

  @@unique([expenseId, memberId])
}

model SplitSettlement {
  id           String      @id @default(cuid())
  groupId      String
  group        SplitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  from         SplitMember @relation("SplitSettlementFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String
  to           SplitMember @relation("SplitSettlementTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  amount       Int
  date         DateTime
  note         String?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([groupId])
}
